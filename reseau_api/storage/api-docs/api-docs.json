        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "equipement_code": { "type": "string" },
                  "name": { "type": "string" },
                  "type": { "type": "string" },
                  "description": { "type": "string" },
                  "direction_in_out": { "type": "string" },
                  "vlan": { "type": "string" },
                  "ip_address": { "type": "string" },
