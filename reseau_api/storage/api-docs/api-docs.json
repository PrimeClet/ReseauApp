{
  "openapi": "3.0.0",
  "info": {
    "title": "Reseau Inventaire App API",
    "version": "1.0.0",
    "description": "Documentation statique minimale de l'API d'inventaire et de cartographie réseau."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8002",
      "description": "Serveur local Laravel"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token généré par Laravel Sanctum (Authorization: Bearer {token})"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "surname": { "type": "string" },
          "username": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "phone": { "type": "string" },
          "role": { "type": "string" },
          "is_active": { "type": "boolean" }
        }
      },
      "Coffret": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "code": { "type": "string" },
          "name": { "type": "string" },
          "piece": { "type": "string" },
          "long": { "type": "number", "format": "float" },
          "lat": { "type": "number", "format": "float" },
          "status": { "type": "string" }
        }
      },
      "Equipement": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "equipement_code": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "direction_in_out": { "type": "string", "nullable": true },
          "vlan": { "type": "string", "nullable": true },
          "ip_address": { "type": "string", "nullable": true },
          "coffret_id": { "type": "integer" },
          "status": { "type": "string" }
        }
      },
      "Port": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "port_label": { "type": "string" },
          "device_name": { "type": "string" },
          "poe_enabled": { "type": "boolean" },
          "vlan": { "type": "string", "nullable": true },
          "speed": { "type": "string", "nullable": true },
          "connected_equipment_id": { "type": "integer", "nullable": true }
        }
      },
      "Metric": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "last_value": { "type": "string", "nullable": true },
          "coffret_id": { "type": "integer" },
          "status": { "type": "boolean" }
        }
      },
      "Liaison": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "from": { "type": "integer" },
          "to": { "type": "integer" },
          "label": { "type": "string" },
          "media": { "type": "string" },
          "length": { "type": "integer", "nullable": true },
          "status": { "type": "boolean" }
        }
      },
      "System": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "vendor": { "type": "string", "nullable": true },
          "endpoint": { "type": "string", "nullable": true },
          "monitored_scope": { "type": "string", "nullable": true },
          "coffret_id": { "type": "integer" },
          "status": { "type": "boolean" }
        }
      },
      "LanNode": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "role": { "type": "string", "enum": ["core","distribution","access","endpoint"] },
          "status": { "type": "string", "enum": ["up","warn","down","maintenance"] },
          "position": {
            "type": "object",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          },
          "site": { "type": "string" },
          "ip": { "type": "string", "nullable": true },
          "model": { "type": "string", "nullable": true },
          "notes": { "type": "string", "nullable": true },
          "icon": { "type": "string", "nullable": true }
        }
      },
      "LanLink": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "type": { "type": "string", "enum": ["fiber","copper","wireless"] },
          "vlan": { "type": "string", "nullable": true },
          "status": { "type": "string", "enum": ["up","warn","down"] },
          "bandwidth": { "type": "string", "nullable": true },
          "fromPort": { "type": "string", "nullable": true },
          "toPort": { "type": "string", "nullable": true }
        }
      },
      "LanTopology": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "subnet": { "type": "string", "nullable": true },
          "vlan": { "type": "string", "nullable": true },
          "description": { "type": "string", "nullable": true },
          "nodes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/LanNode" }
          },
          "links": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/LanLink" }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": ["Authentification"],
        "summary": "Authentifier un utilisateur et récupérer un token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string", "format": "password" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Connexion réussie ou informations invalides"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["Authentification"],
        "summary": "Profil de l'utilisateur connecté",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Utilisateur connecté",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": { "description": "Non authentifié" }
        }
      }
    },
    "/api/coffrets": {
      "get": {
        "tags": ["Coffrets"],
        "summary": "Lister les coffrets",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "schema": { "type": "string" },
            "required": false,
            "description": "Filtrer par statut"
          },
          {
            "in": "query",
            "name": "search",
            "schema": { "type": "string" },
            "required": false,
            "description": "Recherche par nom"
          }
        ],
        "responses": {
          "200": { "description": "Liste paginée de coffrets" },
          "401": { "description": "Non authentifié" },
          "403": { "description": "Non autorisé" }
        }
      },
      "post": {
        "tags": ["Coffrets"],
        "summary": "Créer un coffret",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "piece", "long", "lat"],
                "properties": {
                  "name": { "type": "string" },
                  "piece": { "type": "string" },
                  "long": { "type": "number", "format": "float" },
                  "lat": { "type": "number", "format": "float" },
                  "status": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Coffret créé" },
          "401": { "description": "Non authentifié" },
          "403": { "description": "Non autorisé" },
          "422": { "description": "Erreur de validation" }
        }
      }
    },
    "/api/coffrets/{id}": {
      "get": {
        "tags": ["Coffrets"],
        "summary": "Afficher un coffret",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Coffret",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Coffret" }
              }
            }
          },
          "404": { "description": "Coffret introuvable" }
        }
      },
      "put": {
        "tags": ["Coffrets"],
        "summary": "Mettre à jour un coffret",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "piece": { "type": "string" },
                  "long": { "type": "number", "format": "float" },
                  "lat": { "type": "number", "format": "float" },
                  "status": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Coffret mis à jour" }
        }
      },
      "delete": {
        "tags": ["Coffrets"],
        "summary": "Supprimer un coffret",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Coffret supprimé" }
        }
      }
    },
